NUXT_PUBLIC_SITE_NAME=kwip
NUXT_PUBLIC_CANONICAL_HOST=kwip.fyi
# /fixtures locally; https://api.ppv.st/api live
NUXT_PUBLIC_FEED_BASE=/fixtures
# empty = same as primary
NUXT_PUBLIC_FEED_MIRROR_BASE=

# House banners. Keys are home-banner, event-banner and vods-banner.
# Upload the raster as house.webp to the BANNER_ASSETS R2 bucket and configure
# /banners/house.webp below. Use a new object name for each creative revision.
# The initial R2 binding needs a Worker deploy. Later creatives need only an
# R2 upload and a config update. Use an absolute HTTP(S) destination.
NUXT_PUBLIC_ADS=false
# NUXT_PUBLIC_BANNER_CREATIVES='{"home-banner":{"image":"/banners/house.webp","alt":"House campaign","destination":"https://example.com/campaign"}}'
